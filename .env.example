# ==============================================================
# SHOP MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================
# Copy this file to .env and update values for your environment.
# NEVER commit the actual .env file to source control.
# ==============================================================

# Node Environment
NODE_ENV=production
PORT=5000
WEB_PORT=3000

# --------------------------------------------------------------
# DATABASE CONFIGURATION (Primary PostgreSQL)
# --------------------------------------------------------------
DB_HOST=postgres_live
DB_PORT=5432
DB_NAME=shop_live_db
DB_USER=shop_admin
DB_PASSWORD=shop_secure_password_2026

# Direct Database URL for Prisma / pg Client
DATABASE_URL=postgresql://shop_admin:shop_secure_password_2026@postgres_live:5432/shop_live_db

# Secondary Recovery Database
RECOVERY_DB_HOST=postgres_recovery
RECOVERY_DB_PORT=5432
RECOVERY_DB_NAME=shop_recovery_db
RECOVERY_DB_USER=recovery_admin
RECOVERY_DB_PASSWORD=recovery_secure_password_2026
RECOVERY_DATABASE_URL=postgresql://recovery_admin:recovery_secure_password_2026@postgres_recovery:5432/shop_recovery_db

# --------------------------------------------------------------
# SECURITY & AUTHENTICATION
# --------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_shop_management_ksa_2026_xyz
JWT_EXPIRES_IN=12h

# AES-256 Master Key for Backup Encryption (exactly 32 characters)
BACKUP_ENCRYPTION_KEY=shop_backup_master_key_32_chars!

# --------------------------------------------------------------
# SAUDI ARABIA & SHOP LOCALIZATION
# --------------------------------------------------------------
SHOP_NAME="AL-NOOR RETAIL SHOP"
SHOP_VAT_NUMBER="300123456700003"
SHOP_CR_NUMBER="1010123456"
SHOP_ADDRESS="King Fahd Road, Riyadh, Saudi Arabia"
SHOP_PHONE="+966 11 456 7890"
DEFAULT_CURRENCY=SAR
DEFAULT_TIMEZONE=Asia/Riyadh
STANDARD_VAT_RATE=15.00

# --------------------------------------------------------------
# FILE UPLOADS (Product Images)
# --------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
IMAGE_MAX_WIDTH=800
IMAGE_MAX_HEIGHT=800
THUMBNAIL_WIDTH=200
THUMBNAIL_HEIGHT=200

# --------------------------------------------------------------
# OFFSITE CLOUD BACKUP (S3 / Cloudflare R2)
# --------------------------------------------------------------
# Leave empty to disable remote backup (local backups still work)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=shop-backups-vault
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key
S3_REGION=auto
